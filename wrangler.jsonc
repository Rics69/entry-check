{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entry-check",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Ссылка воркера на самого себя, нужна OpenNext. Имя должно совпадать с "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "entry-check"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entry-check",
      // Боевая база (создана 12 ноября 2026, регион WEUR). Локально (--local) используется своя копия.
      "database_id": "cd7e55c0-3d7d-4443-b031-69a3da17d9d7",
      "migrations_dir": "db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Ежедневно в 06:00 UTC: ставим в Resend напоминания, до которых осталось меньше 30 дней,
  // и рассылаем письма «правила изменились». Обработчик — scheduled() в worker.ts.
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  // worker.ts собирается wrangler'ом, а не Next.js: без этого код правил считал бы, что он не в продакшне,
  // и показывал бы черновики.
  "define": {
    "process.env.NODE_ENV": "\"production\""
  },
  // Адрес сайта для ссылок в письмах cron: worker.ts собирает wrangler, и NEXT_PUBLIC_SITE_URL из сборки Next ему не виден.
  // Пока домена нет — бесплатный адрес workers.dev; после покупки домена поменять здесь и в NEXT_PUBLIC_SITE_URL.
  "vars": {
    "SITE_URL": "https://entry-check.fest-ready.workers.dev"
  }
  // Секреты: npx wrangler secret put ROLLYPAY_API_KEY | ROLLYPAY_SIGNING_SECRET | RESEND_API_KEY
  // Переменные: EMAIL_FROM, ROLLYPAY_TEST — добавить в "vars", когда подключим почту и кассу.
}
