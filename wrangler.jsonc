{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entry-check",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Ссылка воркера на самого себя, нужна OpenNext. Имя должно совпадать с "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "entry-check"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entry-check",
      // Замените на id из `npx wrangler d1 create entry-check` (фаза 0 в docs/DEV_PLAN.md).
      // Для локальной разработки (--local) подходит и этот заполнитель.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Ежедневно в 06:00 UTC: ставим в Resend напоминания, до которых осталось меньше 30 дней,
  // и рассылаем письма «правила изменились». Обработчик — scheduled() в worker.ts.
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  // worker.ts собирается wrangler'ом, а не Next.js: без этого код правил считал бы, что он не в продакшне,
  // и показывал бы черновики.
  "define": {
    "process.env.NODE_ENV": "\"production\""
  }
  // Секреты: npx wrangler secret put ROLLYPAY_API_KEY | ROLLYPAY_SIGNING_SECRET | RESEND_API_KEY
  // Переменные: SITE_URL (адрес сайта для ссылок в письмах cron), EMAIL_FROM, ROLLYPAY_TEST — в "vars" при деплое.
}
