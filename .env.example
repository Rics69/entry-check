# Публичные переменные сборки. Локально: скопируйте в .env.local.
# Подставляются в код при `next build`, поэтому задаются и в окружении сборки на Cloudflare.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Почта поддержки: «Контакты», «Сообщить об ошибке», reply-to писем, гарантия возврата.
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
# Продавец — самозанятый: ФИО и ИНН показываются в условиях, политике конфиденциальности и подвале.
# ФИО латиницей — для английских страниц (если пусто, берётся русское).
NEXT_PUBLIC_SELLER_NAME="Иванов Иван Иванович"
NEXT_PUBLIC_SELLER_NAME_EN="Ivan Ivanov"
NEXT_PUBLIC_SELLER_INN=000000000000
# Оплата Trip Pack: mock — тестовая страница вместо кассы (деньги не списываются),
# rollypay — настоящая касса, off — кнопка «Оплатить» заменяется листом ожидания.
# По умолчанию: mock в разработке, off в продакшн-сборке.
NEXT_PUBLIC_PAYMENTS_MODE=mock
